# Python virtual environments & bytecode
.venv/
__pycache__/
*.py[cod]
*$py.class

# Raw binary EEG files (>100 MB each; downloaded from https://osf.io/u6fgm/ via manuscript/scripts/download_osf_eeg.py)
data/eeg/*.eeg

# Large per-subject intermediate feature caches (>400 MB each; generated by manuscript/scripts/eeg_preproc_and_feats.py)
# Keep group_mvpa_results.npz tracked so Figures 3-7 can be regenerated in <5 seconds
data/cache/*_feats.npz

# LaTeX build intermediates (keep .tex and compiled .pdf files tracked)
manuscript/*.aux
manuscript/*.fdb_latexmk
manuscript/*.fls
manuscript/*.log
manuscript/*.out
manuscript/*.toc
manuscript/*.synctex.gz

# OS & editor metadata
.DS_Store
.vscode/
